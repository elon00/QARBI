# ==============================================================================
# QARBI Protocol - Environment Configuration
# ==============================================================================
# Never commit real secrets. Configure production secrets in Netlify/GitHub settings.

# Optional: required only when Gemini-backed AI planning is enabled.
GEMINI_API_KEY=""

# Server Port
PORT=3000

# Application Public URL
APP_URL="http://localhost:3000"

# Arbitrum Sepolia RPC Endpoint
ARBITRUM_SEPOLIA_RPC="https://sepolia-rollup.arbitrum.io/rpc"

# Deployment key: required only for npm run deploy:testnet.
# Keep this empty in committed files and CI unless deployment is intentionally authorized.
DEPLOYER_PRIVATE_KEY=""
