# ==============================================================================
# QARBI Protocol - Environment Configuration
# ==============================================================================

# Google Gemini API Key (Required for AI Agent Reasoning & Task Decomposition)
# Obtain your key from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-3.5-flash"

# Server Port (Default: 3000)
PORT=3000

# Application Public URL
APP_URL="http://localhost:3000"

# Arbitrum Sepolia RPC Endpoint (Optional / Fallback)
ARBITRUM_SEPOLIA_RPC="https://sepolia-rollup.arbitrum.io/rpc"
