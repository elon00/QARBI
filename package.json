{
  "name": "qarbi-protocol",
  "version": "1.0.0",
  "description": "QARBI Protocol — autonomous AI-agent coordination prototype on Arbitrum Sepolia with policy guardrails, task escrow, Conway state simulation, and PQC research interfaces.",
  "type": "module",
  "author": {
    "name": "Martin Luther",
    "email": "martinlutherupa1@gmail.com",
    "url": "https://github.com/elon00"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/elon00/QARBI.git"
  },
  "bugs": {
    "url": "https://github.com/elon00/QARBI/issues"
  },
  "homepage": "https://github.com/elon00/QARBI#readme",
  "license": "MIT",
  "keywords": [
    "arbitrum",
    "arbitrum-sepolia",
    "ai-agents",
    "autonomous-agents",
    "conway-game-of-life",
    "post-quantum-cryptography",
    "ml-dsa",
    "web4",
    "gemini-ai",
    "blockchain",
    "smart-contracts"
  ],
  "scripts": {
    "dev": "tsx server.ts",
    "build": "vite build && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs",
    "start": "node dist/server.cjs",
    "clean": "rm -rf dist server.js build",
    "typecheck": "tsc --noEmit",
    "lint": "tsc --noEmit",
    "compile:contracts": "node scripts/compile.js",
    "generate:artifacts": "node scripts/generateArtifacts.js",
    "check:env": "node scripts/check-env.mjs",
    "check:truth": "node scripts/check-truth.mjs",
    "check:repo": "node scripts/qarbi-finish.mjs --audit-only",
    "test:nist": "tsx src/crypto/tests/official-nist-vectors.test.ts",
    "test:quantum": "tsx src/crypto/tests/quantum-portfolio-communication.test.ts",
    "audit:crypto": "node scripts/audit-crypto.mjs",
    "reality:universal": "tsx scripts/reality-universal.ts",
    "reality:certify": "tsx scripts/generate-urs-certificate.ts",
    "finish": "node scripts/qarbi-finish.mjs",
    "test": "npm run test:nist && npm run test:quantum && npm run audit:crypto && npm run finish"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@noble/ciphers": "^2.4.0",
    "@noble/hashes": "^1.8.0",
    "@noble/post-quantum": "^0.7.1",
    "@tailwindcss/vite": "^4.1.14",
    "@vitejs/plugin-react": "^5.0.4",
    "dotenv": "^17.2.3",
    "ethers": "^6.17.0",
    "express": "^4.21.2",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "solc": "^0.8.24",
    "vite": "^6.2.3"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.25.0",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2"
  }
}
